# 复制本文件为 deploy.env，填好必填项，然后 bash deploy.sh
# deploy.env 已在 .gitignore 里，不会被提交

# ── 必填 ────────────────────────────────────────────────────────────────
# Cloudflare API Token：https://dash.cloudflare.com/profile/api-tokens
#   用「Create Token → Custom token」，权限给：
#     Account · Workers Scripts · Edit
#     Account · Workers KV Storage · Edit
#     Account · Account Settings · Read
#   Account Resources 选你自己的账号
CLOUDFLARE_API_TOKEN=

# ── 对话模型（二选一，默认智谱免费档）──────────────────────────────────
# zhipu    = 智谱 GLM-4.7-Flash，输入输出全免费，国内速度快（推荐）
# deepseek = DeepSeek flash，按 token 计费，支持联网搜索
AI_PROVIDER=zhipu

# 智谱 API Key：https://bigmodel.cn/usercenter/apikeys
#   AI_PROVIDER=zhipu 时必填；Flash 系列免费，注册不用充值
ZHIPU_API_KEY=

# DeepSeek API Key：https://platform.deepseek.com/api_keys
#   只有 AI_PROVIDER=deepseek，或想开联网搜索时才需要填
DEEPSEEK_API_KEY=

# ── 选填 ────────────────────────────────────────────────────────────────
# 不填则自动取你名下第一个账户
CLOUDFLARE_ACCOUNT_ID=

# Worker 名字，默认 shiqian-agent
WORKER_NAME=shiqian-agent

# 美团团购：美团 App 扫码授权拿到的 token（约 30 天有效，过期重取）
# 不填时面板显示「美团 · 不可用」，其它功能不受影响
MEITUAN_TOKEN=

# 美团酒旅（可选，个人开发者 token）
MEITUAN_TRAVEL_TOKEN=

# 淘宝闪购开放平台：商家维度，个人应用通常拿不到「附近商品」
# 四项都不填就整体显示「待配置」，不会编数据
SHANGOU_APP_KEY=
SHANGOU_APP_SECRET=
SHANGOU_TOKEN=
SHANGOU_SHOP_ID=
