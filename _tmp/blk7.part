      { pattern: /(甜|点心|下午茶|甜品|蛋糕)/, foods: ['抹茶甜品', '提拉米苏', '章鱼小丸子'] },
      { pattern: /(快|简单|方便|上班|赶时间)/, foods: ['蛋包饭', '日式咖喱饭', '小笼包'] },
      { pattern: /(暖|汤|热乎|天气冷|暖胃)/, foods: ['红烧牛肉面', '海鲜粥', '越南河粉', '日式咖喱饭'] },
      { pattern: /(面|面条|粉)/, foods: ['红烧牛肉面', '意大利面', '酸辣粉', '越南河粉'] }
    ];

    preferenceRules.forEach(rule => {
      if (rule.pattern.test(lower)) {
        rule.foods.forEach(name => preferredNames.add(name));
      }
    });

    let candidates = foodDatabase.filter(food => {
      if (/(不辣|忌辣|免辣|怕辣)/.test(lower) && /(辣|麻)/.test(food.name)) return false;
      if (wantsSpicy) return /(辣|麻)/.test(food.name);
      return preferredNames.size === 0 || preferredNames.has(food.name);
    });

    if (candidates.length === 0) candidates = [...foodDatabase];

    const previousFood = history[0]?.name;
    const variedCandidates = candidates.length > 1
      ? candidates.filter(food => food.name !== previousFood)
      : candidates;
    const pool = variedCandidates.length > 0 ? variedCandidates : candidates;
    const food = pool[Math.floor(Math.random() * pool.length)];

    const openings = [
      `根据你的描述，食神推荐你试试【${food.name}】${food.emoji}`,
      `让食神想了想，今天适合吃【${food.name}】${food.emoji}`,
      `食神感应到你的需求，为你推荐【${food.name}】${food.emoji}`
    ];

    return `${openings[Math.floor(Math.random() * openings.length)]}\n\n${food.desc}\n\n「${food.blessing}」`;
  }
  createPetals();

  // ===== v0.5 启动：初始化平台面板 =====
  if (window.ShiqianPane) {
    window.ShiqianPane.init();
  }
  </script>
  <!-- sound fx + ambient rain/wind -->
  <style>
    .sound-widget{position:fixed;right:14px;bottom:14px;z-index:6000;display:flex;flex-direction:column;align-items:flex-end;gap:8px;font-family:var(--font-xingkai,'Microsoft YaHei',sans-serif);}
    .snd-btn{min-width:72px;padding:9px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.28);background:rgba(15,23,42,.72);color:#e2e8f0;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);cursor:pointer;font-family:inherit;font-size:15px;transition:transform .15s,background .2s;}
    .snd-btn:hover{transform:translateY(-1px);background:rgba(30,41,59,.92);}
    .snd-menu{display:none;flex-direction:column;gap:4px;padding:6px;border-radius:10px;background:rgba(15,23,42,.9);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);}
    .snd-opt{border:none;background:transparent;color:#cbd5e1;padding:6px 16px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px;text-align:right;}
    .snd-opt:hover{background:rgba(255,255,255,.08);color:#fff;}
    .snd-opt.active{background:rgba(56,189,248,.25);color:#7dd3fc;}
  </style>
  <div class="sound-widget" id="soundWidget" role="group" aria-label="环境音"></div>
  <script>
  (function(){
    var ctx = null, amb = null, current = 'off';
    function ensureCtx(){
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      if (ctx.state === 'suspended') ctx.resume();
      return ctx;
    }
    function playClick(){
      try {
        var c = ensureCtx(), now = c.currentTime;
        var o = c.createOscillator(), g = c.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(900, now);
        o.frequency.exponentialRampToValueAtTime(480, now + 0.05);
        g.gain.setValueAtTime(0.0001, now);
        g.gain.exponentialRampToValueAtTime(0.14, now + 0.006);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);
        o.connect(g).connect(c.destination);
        o.start(now); o.stop(now + 0.1);
      } catch(e){}
    }
    function noiseBuffer(type){
      var c = ensureCtx(), len = c.sampleRate * 2;
      var buf = c.createBuffer(1, len, c.sampleRate);
      var d = buf.getChannelData(0);
      if (type === 'rain'){
        for (var i=0;i<len;i++){ d[i] = Math.random()*2-1; }
      } else {
        var last = 0;
        for (var j=0;j<len;j++){ var w = Math.random()*2-1; last = (last + 0.02*w)/1.02; d[j] = last*3.5; }
      }
      return buf;
    }
    function stopAmbient(){
      if (!amb) return;
      var c = ensureCtx(), a = amb; amb = null;
      try {
        var t = c.currentTime;
        a.gain.gain.cancelScheduledValues(t);
        a.gain.gain.setValueAtTime(a.gain.gain.value, t);
        a.gain.gain.linearRampToValueAtTime(0, t + 0.6);
        setTimeout(function(){
          try{ a.src.stop(); }catch(e){}
          if (a.lfos){ try{a.lfos[0].stop();}catch(e){} try{a.lfos[1].stop();}catch(e){} }
        }, 700);
      } catch(e){}
    }
    function startAmbient(which){
      stopAmbient();
      var c = ensureCtx();
      var src = c.createBufferSource(); src.buffer = noiseBuffer(which); src.loop = true;
      var filter = c.createBiquadFilter(); filter.type = 'lowpass';
      var gain = c.createGain(); gain.gain.setValueAtTime(0, c.currentTime);
      var lfos = null;
      if (which === 'rain'){
        var hp = c.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 400;
        filter.frequency.value = 2000;
        src.connect(hp); hp.connect(filter);
        gain.gain.linearRampToValueAtTime(0.42, c.currentTime + 1.2);
      } else {
        filter.frequency.value = 500;
        src.connect(filter);
        gain.gain.linearRampToValueAtTime(0.34, c.currentTime + 1.2);
        var lfo = c.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.08;
        var lg = c.createGain(); lg.gain.value = 0.13; lfo.connect(lg); lg.connect(gain.gain);
        var lfo2 = c.createOscillator(); lfo2.type = 'sine'; lfo2.frequency.value = 0.05;
        var lf = c.createGain(); lf.gain.value = 260; lfo2.connect(lf); lf.connect(filter.frequency);
        lfo.start(); lfo2.start();
        lfos = [lfo, lfo2];
      }
      filter.connect(gain); gain.connect(c.destination);
      src.start();
      amb = { src: src, gain: gain, lfos: lfos };
    }
    function setAmbient(which){
      if (which === current) return;
      current = which;
      if (which === 'off') stopAmbient(); else startAmbient(which);
      updateUI();
    }
    var labels = { off: '🔊 关', rain: '🌧️ 雨声', wind: '🌬️ 风声' };
    function updateUI(){
      var b = document.getElementById('sndToggle');
      if (b) b.textContent = labels[current];
      document.querySelectorAll('#soundWidget .snd-opt').forEach(function(o){
        o.classList.toggle('active', o.getAttribute('data-mode') === current);
      });
    }
    var w = document.getElementById('soundWidget');
    if (w){
      w.innerHTML =
        '<button id="sndToggle" class="snd-btn" type="button">🔊 关</button>' +
        '<div class="snd-menu" id="sndMenu">' +
        '<button class="snd-opt" type="button" data-mode="off">关闭</button>' +
        '<button class="snd-opt" type="button" data-mode="rain">雨声</button>' +
        '<button class="snd-opt" type="button" data-mode="wind">风声</button>' +
        '</div>';
      var menu = document.getElementById('sndMenu');
      document.getElementById('sndToggle').addEventListener('click', function(e){
        e.stopPropagation(); playClick();
        menu.style.display = (menu.style.display === 'none') ? 'flex' : 'none';
      });
      menu.querySelectorAll('.snd-opt').forEach(function(o){
        o.addEventListener('click', function(e){
          e.stopPropagation(); playClick();
          setAmbient(this.getAttribute('data-mode'));
          menu.style.display = 'none';
        });
      });
      document.addEventListener('click', function(){ menu.style.display = 'none'; });
    }
    document.querySelectorAll('.draw-btn, .llm-send-btn, .sign-container').forEach(function(el){
      el.addEventListener('click', function(){ playClick(); }, { passive: true });
    });
    updateUI();
  })();
  </script>
</body>
</html>