    const dayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const dayFrac = (now.getTime() - dayStart) / 86400000;   // 0..1，一天一轮
    const rotation = Math.floor(dayFrac * n);                // 轮替基准，一天转一圈
    const span = Math.max(1, Math.round(n * 0.4));           // 随机窗口（约 40%）
    return foods[(rotation + Math.random() * span) % n | 0];
  }
  function pickCyclicSignNumber() {
    return Math.floor(Math.random() * 99) + 1;                // 签号每次都随机
  }

  function startDraw() {
    if (isDrawing) return;
    isDrawing = true;
    isStickOpened = false;

    const overlay = document.getElementById('immersiveOverlay');
    const container = document.getElementById('immersiveContainer');
    const flyingStick = document.getElementById('flyingStick');
    const stickSealed = document.getElementById('stickSealed');
    const stickCard = document.getElementById('stickCard');
    const glowEffect = document.getElementById('glowEffect');
    const closeHint = document.getElementById('closeHint');

    container.classList.remove('show', 'shaking');
    flyingStick.classList.remove('fly-out', 'opened');
    stickSealed.classList.remove('hidden');
    stickCard.classList.remove('unfold');
    glowEffect.classList.remove('active');
    closeHint.classList.remove('show');
    const cpReset = document.getElementById('cardPlatform');
    if (cpReset) { cpReset.hidden = true; cpReset.innerHTML = ''; }

    overlay.classList.add('active');

    const food = pickCyclicFood();
    const signNum = pickCyclicSignNumber();

    document.getElementById('sealedFortune').textContent = food.fortune;
    document.getElementById('cardFortune').textContent = food.fortune;
    document.getElementById('cardNumber').textContent = `第 ${numToChinese(signNum)} 签`;
    document.getElementById('cardEmoji').textContent = food.emoji;
    document.getElementById('cardFoodName').textContent = food.name;
    document.getElementById('cardFoodDesc').textContent = food.desc;
    document.getElementById('cardBlessing').textContent = food.blessing;

    window.currentFood = food;

    setTimeout(() => { container.classList.add('show'); }, 300);
    setTimeout(() => { container.classList.add('shaking'); }, 900);
    setTimeout(() => {
      container.classList.remove('shaking');
      flyingStick.classList.add('fly-out');
      glowEffect.classList.add('active');
      createParticles();
    }, 2800);
    setTimeout(() => {
      closeHint.classList.add('show');
      isDrawing = false;
    }, 3600);
  }

  function numToChinese(num) {
    const chars = ['零','一','二','三','四','五','六','七','八','九','十'];
    if (num <= 10) return chars[num];
    if (num < 20) return '十' + (num % 10 === 0 ? '' : chars[num % 10]);
    if (num < 100) {
      const tens = Math.floor(num / 10);
      const ones = num % 10;
      return chars[tens] + '十' + (ones === 0 ? '' : chars[ones]);
    }
    return '九十九';
  }

  function createParticles() {
    const container = document.getElementById('particlesContainer');
    container.innerHTML = '';
    
    for (let i = 0; i < 30; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      const angle = (Math.PI * 2 * i) / 30;
      const distance = 80 + Math.random() * 120;
      const tx = Math.cos(angle) * distance;
      const ty = Math.sin(angle) * distance;
      particle.style.setProperty('--tx', tx + 'px');
      particle.style.setProperty('--ty', ty + 'px');
      particle.style.left = '50%';
      particle.style.top = '40%';
      particle.style.width = (2 + Math.random() * 4) + 'px';
      particle.style.height = particle.style.width;
      particle.style.background = Math.random() > 0.5 ? 'var(--gold)' : 'var(--text-secondary)';
      
      setTimeout(() => {
        particle.classList.add('active');
      }, Math.random() * 500);
      
      container.appendChild(particle);
    }
  }

  function openStick(event) {
    event.stopPropagation();
    if (isStickOpened) return;
    isStickOpened = true;

    const stickSealed = document.getElementById('stickSealed');
    const stickCard = document.getElementById('stickCard');
    const flyingStick = document.getElementById('flyingStick');

    stickSealed.classList.add('hidden');
    
    setTimeout(() => {
      stickCard.classList.add('unfold');
      flyingStick.classList.add('opened');
      addHistory(window.currentFood);
      // v0.5：翻开签的同时，去平台找这道菜的真实商品
      loadCardPlatform(window.currentFood);
    }, 300);
  }

  // ===== v0.5：把签和真实商品接上 =====
  // 签是"想吃什么"，平台面板是"哪里能买到"，这一步负责把两件事连起来。
  function loadCardPlatform(food) {
    const box = document.getElementById('cardPlatform');
    if (!box || !food) return;
    box.hidden = false;
    box.innerHTML = '<div class="card-platform-main">正在美团 / 闪购找「' + food.name + '」…</div>';

    const timer = setTimeout(() => {
      box.innerHTML = '<div class="card-platform-main">平台响应有点慢，先按签上说的吃吧。</div>';
    }, 12000);

    if (!window.ShiqianPane || !window.ShiqianApi || window.ShiqianApi.config.mock) {
      clearTimeout(timer);
      box.hidden = true;
      return;
    }

    window.ShiqianPane.searchByFood(food.name).then(res => {
      clearTimeout(timer);
      const hit = (res && res.products && res.products[0]) || null;
      const anyConfigured = res && res.sources &&
        (res.sources.meituan === 'ok' || res.sources.shangou === 'ok');

      if (!hit) {
        box.innerHTML = '<div class="card-platform-main">' +
          (anyConfigured ? '附近暂时没搜到这道菜，换个签再看看。' : '平台还没接上，签依然是签。') +
          '</div>';
        return;
      }

      const price = window.ShiqianNormalizer.money(hit.price);
      const shopName = hit.shopName || '附近门店';

      if (hit.url) {
        const a = document.createElement('a');
        a.className = 'card-platform-link';
        a.href = hit.url;
        a.target = '_blank';
        a.rel = 'noopener nofollow';
        a.textContent = `去${window.ShiqianNormalizer.SOURCE_META[hit.source].label}下单 ${price}`;
        box.innerHTML = '<div class="card-platform-main">' + shopName + ' · ' + price + '</div>';
        box.appendChild(a);
      } else {
        box.innerHTML = '<div class="card-platform-main">' + shopName + ' · ' + price + '（下方「附近可下单」可看详情）</div>';
      }
    }).catch(() => {
      clearTimeout(timer);
      box.innerHTML = '<div class="card-platform-main">平台暂时没响应，稍后再试。</div>';
    });
  }

  function addHistory(food) {
    const now = new Date();
    const timeStr = now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
    
    history.unshift({ name: food.name, emoji: food.emoji, time: timeStr });
    if (history.length > 5) history.pop();
    
    renderHistory();
  }

  function renderHistory() {
    const list = document.getElementById('historyList');
    list.innerHTML = history.map(item => `
      <div class="history-item">
        <span class="food-name">${item.emoji} ${item.name}</span>
        <span class="food-time">${item.time}</span>
      </div>
    `).join('');
  }

  function handleOverlayClick(event) {
    if (event.target === document.getElementById('immersiveOverlay') || 
        event.target === document.getElementById('particlesContainer') ||
        event.target === document.getElementById('glowEffect')) {
      closeOverlay();
    }
  }

  function closeOverlay() {
    const overlay = document.getElementById('immersiveOverlay');
    const container = document.getElementById('immersiveContainer');
    
    overlay.classList.add('closing');
    container.classList.remove('show');
    
    setTimeout(() => {
      overlay.classList.remove('active', 'closing');
      container.classList.remove('show', 'shaking');
      document.getElementById('flyingStick').classList.remove('fly-out', 'opened');