  // ================= 后端 / Agent 配置（v0.5） =================
  // 后端上线后（见 backend/README.md），把 Worker 地址填到下面这行，末尾不带斜杠。
  // 例如：const API_BASE = 'https://shiqian-api.你的子域.workers.dev';
  // 留空（''）时走同源 /api/*；两者都不可达时自动降级为本地食神 + 本地签库。
  const API_BASE = 'https://shiqian-agent.3314445455.workers.dev';

  // mock = true 时完全不发网络请求，用 app/js/mock.js 的示例数据预览 UI。
  const USE_MOCK = false;

  // AI 接口：POST /v1/chat
  // 请求：{ messages, context: { city, lat, lng, foods[], currentFood, prefs[] } }
  // 响应：{ reply, foodName?, recommend?, sources?[], model, provider, usage }
  const AGENT_CONFIG = Object.freeze({
    model: 'glm-4.7-flash',
    timeoutMs: 40000,
    fallbackToLocal: true,
    maxHistoryMessages: 8
  });

  if (window.ShiqianApi) {
    window.ShiqianApi.configure({ baseUrl: API_BASE ? API_BASE + '/api' : '/api', mock: USE_MOCK });
  }

  let conversation = [];
  let isSending = false;
  let isDrawing = false;
  let isStickOpened = false;
  let history = [];

  // ===== 深浅色主题切换 =====
  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    var btn = document.getElementById('themeToggle');
    if (btn) btn.textContent = theme === 'dark' ? '☀️' : '🌙';
  }
  function initTheme() {
    var saved = null;
    try { saved = localStorage.getItem('theme'); } catch (e) {}
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    applyTheme(saved || (prefersDark ? 'dark' : 'light'));
  }
  function toggleTheme() {
    var cur = document.documentElement.getAttribute('data-theme');
    var next = cur === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  }
  initTheme();

  function createPetals() {
    const body = document.body;
    for (let i = 0; i < 8; i++) {
      const petal = document.createElement('div');
      petal.className = 'petal';
      petal.style.left = Math.random() * 100 + '%';
      petal.style.animationDuration = (8 + Math.random() * 6) + 's';
      petal.style.animationDelay = Math.random() * 10 + 's';
      petal.style.width = (6 + Math.random() * 8) + 'px';
      petal.style.height = (6 + Math.random() * 8) + 'px';
      body.appendChild(petal);
    }
  }

  // ===== 抽签：24h 周期轮替 + 每次随机变换 =====
  // 每支签都随机变化（同一时段不会锁死同一支），但整体以「一天 24 小时」
  // 为一个周期做轮替：用当前时刻在一天中的位置作为轮替基准，随机窗口围绕
  // 基准取材，保证一整天把菜系轮替一圈。
  const DRAW_24H_PERIOD = true;   // 设为 false 则完全纯随机
  function pickCyclicFood(now = new Date()) {
    const foods = foodDatabase;
    const n = foods.length;
    if (!DRAW_24H_PERIOD) return foods[Math.floor(Math.random() * n)];