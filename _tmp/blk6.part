      document.getElementById('stickSealed').classList.remove('hidden');
      document.getElementById('stickCard').classList.remove('unfold');
      const cp = document.getElementById('cardPlatform');
      if (cp) { cp.hidden = true; cp.innerHTML = ''; }
      document.getElementById('glowEffect').classList.remove('active');
      document.getElementById('closeHint').classList.remove('show');
      isStickOpened = false;
    }, 500);
  }

  function handleKeyDown(event) {
    if (event.key === 'Enter' && !event.isComposing) {
      event.preventDefault();
      sendLLM();
    }
  }

  function setAgentLoading(isLoading) {
    const input = document.getElementById('llmInput');
    const sendButton = document.getElementById('llmSendBtn');
    const thinking = document.getElementById('llmThinking');
    const result = document.getElementById('llmResult');

    input.disabled = isLoading;
    sendButton.disabled = isLoading;
    sendButton.textContent = isLoading ? '思考中' : '发送';
    thinking.classList.toggle('show', isLoading);

    if (isLoading) {
      result.classList.remove('show');
    } else {
      input.focus({ preventScroll: true });
    }
  }

  function extractAgentReply(payload) {
    if (typeof payload === 'string') return payload.trim();

    const candidates = [
      payload?.reply,
      payload?.content,
      typeof payload?.message === 'string' ? payload.message : payload?.message?.content,
      payload?.choices?.[0]?.message?.content
    ];

    const reply = candidates.find(value => typeof value === 'string' && value.trim());
    return reply ? reply.trim() : '';
  }

  function normalizeReply(reply) {
    return String(reply)
      .replace(/\*\*(.*?)\*\*/g, '$1')
      .replace(/^#{1,6}\s*/gm, '')
      .trim();
  }

  // v0.5：后端返回的是结构化推荐（recommend），前端把签库切成
  // 「平台有货」和「纯签库」两池，优先在真实商品里出签。
  function resolveFood(payload, reply) {
    const explicitName = payload?.foodName || payload?.recommend?.foodName || payload?.food?.name;
    const bracketName = reply && reply.match(/【([^】]{1,24})】/)?.[1];
    const candidate = typeof explicitName === 'string' ? explicitName.trim() : bracketName;

    if (candidate) {
      const exact = foodDatabase.find(food => food.name === candidate || candidate.includes(food.name));
      if (exact) return exact;
      // 平台真实推荐不在本地签库里，合成一支临时签，保证卡片能显示
      return {
        name: candidate,
        emoji: payload?.recommend?.emoji || '🍽️',
        desc: payload?.recommend?.reason || '食神从附近真实商品里挑的，点下面的按钮直接去平台看。',
        fortune: payload?.recommend?.fortune || '吉',
        blessing: payload?.recommend?.blessing || '顺心顺口，刚刚好',
        ephemeral: true
      };
    }

    return foodDatabase.find(food => reply && reply.includes(food.name));
  }

  async function requestFoodgod() {
    const ctx = window.ShiqianPrefs ? window.ShiqianPrefs.current() : null;
    const pane = window.ShiqianPane && window.ShiqianPane.state;

    const currentFood = window.currentFood
      ? { name: window.currentFood.name, desc: window.currentFood.desc }
      : null;

    return window.ShiqianApi.chat({
      messages: conversation.slice(-AGENT_CONFIG.maxHistoryMessages),
      timeoutMs: AGENT_CONFIG.timeoutMs,
      context: {
        city: ctx ? ctx.city.name : '',
        lat: ctx ? ctx.lat : undefined,
        lng: ctx ? ctx.lng : undefined,
        currentFood,
        // 附近已有平台数据时只传前 20 条，避免 prompt 过长（省钱）
        nearby: pane ? (pane.products || []).slice(0, 20).map(p => ({
          name: p.title,
          price: p.price,
          shop: p.shopName,
          source: p.source
        })) : [],
        foods: foodDatabase.map(food => ({ name: food.name, desc: food.desc }))
      }
    });
  }

  function renderAgentReply(reply, sourceLabel, sourceType, detail = '', sources = []) {
    const result = document.getElementById('llmResult');
    const source = document.createElement('div');
    const content = document.createElement('div');

    source.className = 'agent-reply-source';
    source.textContent = detail ? `${sourceLabel} · ${detail}` : sourceLabel;
    content.textContent = normalizeReply(reply);

    result.replaceChildren(source, content);

    // 联网搜索结果作为小字来源列表，让用户知道这句话有出处
    if (Array.isArray(sources) && sources.length) {
      const box = document.createElement('div');
      box.className = 'agent-sources';
      box.appendChild(document.createTextNode('参考：'));
      sources.slice(0, 3).forEach((s, i) => {
        const a = document.createElement('a');
        a.href = s.url || '#';
        a.target = '_blank';
        a.rel = 'noopener nofollow';
        a.textContent = `${i + 1}. ${s.title || s.site || '来源'}`;
        box.appendChild(a);
      });
      result.appendChild(box);
    }

    result.dataset.source = sourceType;
    result.classList.add('show');
  }

  async function sendLLM() {
    const input = document.getElementById('llmInput');
    const text = input.value.trim();

    if (!text || isSending) return;

    isSending = true;
    input.value = '';
    setAgentLoading(true);
    conversation.push({ role: 'user', content: text });

    try {
      const payload = await requestFoodgod();
      const reply = normalizeReply(extractAgentReply(payload));
      const food = resolveFood(payload, reply);

      renderAgentReply(
        reply,
        payload.searchUsed ? '美团 · 闪购 · 联网搜索' : '美团 · 闪购',
        payload.provider || 'ai',
        payload.model || AGENT_CONFIG.model,
        payload.sources || []
      );
      document.getElementById('agentBadge').textContent = payload.model || AGENT_CONFIG.model;
      document.getElementById('agentHint').textContent = payload.searchUsed
        ? '本条回复已联网核对附近真实门店与团购。'
        : '本条回复基于城市、口味与附近平台数据生成（未联网搜索）。';
      conversation.push({ role: 'assistant', content: reply });

      if (food) {
        addHistory(food);
        // 把 AI 选的那道菜作为关键词，刷新下方平台面板
        if (window.ShiqianPane) window.ShiqianPane.searchByFood(food.name);
      }
    } catch (error) {
      console.warn('食神后端调用失败：', error);

      if (!AGENT_CONFIG.fallbackToLocal) {
        renderAgentReply('暂时无法连接食神，请稍后重试。', '连接失败', 'local');
      } else {
        const reply = generateRecommendation(text);
        const food = resolveFood(null, reply);

        renderAgentReply(reply, '本地食神', 'local', '降级模式');
        document.getElementById('agentBadge').textContent = '本地降级';
        document.getElementById('agentHint').textContent = (error && error.code === 'UPSTREAM_BUSY')
          ? '食神通道排队中（免费额度并发限制），这次用本地推荐顶上，过一会儿会自动恢复。'
          : '后端暂不可用，当前使用本地推荐。配置好后会自动切换。';
        conversation.push({ role: 'assistant', content: reply });

        if (food) addHistory(food);
      }
    } finally {
      isSending = false;
      setAgentLoading(false);
    }
  }

  function generateRecommendation(input) {
    const lower = input.toLowerCase();
    const wantsSpicy = /(辣|麻辣|刺激)/.test(lower) && !/(不辣|忌辣|免辣|怕辣|微辣)/.test(lower);
    const preferredNames = new Set();

    const preferenceRules = [
      { pattern: /(清淡|健康|减脂|低脂|素|养胃)/, foods: ['海鲜粥', '越南河粉', '寿司拼盘', '抹茶甜品', '小笼包'] },
      { pattern: /(日式|日本|寿司|咖喱|鳗鱼)/, foods: ['寿司拼盘', '鳗鱼饭', '章鱼小丸子', '日式咖喱饭'] },
      { pattern: /(肉|大份|饱腹|烤肉|牛肉|烤鸭|炸鸡)/, foods: ['烤肉套餐', '红烧牛肉面', '北京烤鸭', '炸鸡配啤酒'] },